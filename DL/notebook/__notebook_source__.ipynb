# Draw bounding boxes
annotated_img = img.copy()

for ann in image_annotations:
    x, y, w, h = ann["bbox"]
    class_name = category_names[ann["category_id"]]

    x1, y1 = int(x), int(y)
    x2, y2 = int(x + w), int(y + h)

    cv2.rectangle(
        annotated_img,
        (x1, y1),
        (x2, y2),
        (0, 255, 0),
        2
    )

    cv2.putText(
        annotated_img,
        class_name,
        (x1, max(y1 - 5, 15)),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.4,
        (255, 0, 0),
        1
    )

