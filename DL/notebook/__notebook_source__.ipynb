##Convert COCO annotations to YOLO format
for split in ["train", "valid", "test"]:

    annotation_path = os.path.join(
        basepath, split, "_annotations.coco.json"
    )

    with open(annotation_path, "r") as file:
        data = json.load(file)

    # Map COCO category IDs 1-30 to YOLO class IDs 0-29
    actual_categories = [
        category for category in data["categories"]
        if category["id"] != 0
    ]

    category_mapping = {
        category["id"]: index
        for index, category in enumerate(actual_categories)
    }

    # Group annotations by image ID
    annotations_by_image = {}

    for ann in data["annotations"]:
        annotations_by_image.setdefault(
            ann["image_id"], []
        ).append(ann)

    labels_folder = os.path.join(project_path, split, "labels")

    total_objects = 0

    for image_info in data["images"]:

        image_id = image_info["id"]
        image_name = image_info["file_name"]

        image_width = image_info["width"]
        image_height = image_info["height"]

        label_name = os.path.splitext(image_name)[0] + ".txt"
        label_path = os.path.join(labels_folder, label_name)

        yolo_labels = []

        for ann in annotations_by_image.get(image_id, []):

            category_id = ann["category_id"]

            if category_id == 0:
                continue

            class_id = category_mapping[category_id]

            x, y, w, h = ann["bbox"]

            x_center = (x + w / 2) / image_width
            y_center = (y + h / 2) / image_height

            norm_width = w / image_width
            norm_height = h / image_height

            yolo_labels.append(
                f"{class_id} {x_center:.6f} {y_center:.6f} "
                f"{norm_width:.6f} {norm_height:.6f}"
            )

        with open(label_path, "w") as file:
            file.write("\n".join(yolo_labels))

        total_objects += len(yolo_labels)

    print(f"{split.upper()} conversion completed")
    print("Total images:", len(data["images"]))
    print("Total objects converted:", total_objects)
    print("Total label files:", len(os.listdir(labels_folder)))


