###Prepare the model for download
import shutil
import zipfile
import os

# Create model package folder
package_path = "/kaggle/working/MedEquip30_Model"

os.makedirs(package_path, exist_ok=True)

# Copy best trained model
shutil.copy2(
    best_model_path,
    os.path.join(package_path, "best.pt")
)

# Copy dataset configuration
shutil.copy2(
    yaml_path,
    os.path.join(package_path, "data.yaml")
)

# Create ZIP file
zip_path = "/kaggle/working/MedEquip30_Model.zip"

with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as zipf:
    zipf.write(
        os.path.join(package_path, "best.pt"),
        arcname="best.pt"
    )
    zipf.write(
        os.path.join(package_path, "data.yaml"),
        arcname="data.yaml"
    )

print("Model package created successfully!")
print("ZIP file:", zip_path)
print("ZIP size:", round(os.path.getsize(zip_path) / (1024 * 1024), 2), "MB")


